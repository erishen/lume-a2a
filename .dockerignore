# 不进镜像(前端已 build 好直接 COPY, 镜像里不跑 node)
node_modules

# 构建上下文里只需要 vendor/(lume 二进制) + .runtime/lume-core/lib + 源码
.git

# .runtime 里绝大多数是临时产物; 唯一例外是 lume-core/lib —— make docker-build
# 会把它同步进来, Dockerfile 再 COPY 到镜像根 /lume-core/lib。
.runtime
!.runtime/lume-core
!.runtime/lume-core/lib
!.runtime/lume-core/lib/**

# 本地数据(任务)/ 凭据, 用挂载卷提供
.data
.env

# 根目录误留的 vendor 副本(copy 时参数写错留下的); 镜像只用 vendor/ 下的那份。
lume-linux-*-static.tar.gz
lume-linux-*-static.sha

# 草稿/临时文件
*.log
*.part
*.tmp
.DS_Store
