import "../../lume-core/lib/peer.lume" as core_peer;

// ══════════════════════════════════════════════════════════════════════
// 演示场景 —— peer 之间真正「协作」才看得出 A2A 的价值
// ══════════════════════════════════════════════════════════════════════
//
// 原来的四个能力(overview/echo/aggregate/relay)是**单跳**的: 一次请求一个响应,
// 谁都看不出两个节点在协作。这里加三个场景, 每个都展示 A2A 规范里一个真实能力:
//
//   1) plan.split    任务分解 —— 发起方只给目标, 由对端报出它缺什么
//   2) report.compose 多轮补全 —— input-required → 客户端补充 → 同一 taskId 继续
//   3) batch.process  长任务   —— submitted → working → completed/canceled, 可轮询
//
// 三个都刻意做成**需要两次以上往返**。单次往返的演示没有说服力: 看不出
// "为什么需要协议", 只看得出"两台机器能互相发 HTTP"。

// ── 1) 任务分解: 对端按自己的库存报缺口 ─────────────────────────────
//
// 演示的是 A2A 最有价值的一点: 调用方**不需要知道**对端有什么。
// 它只把目标发过去, 对端用自己的能力清单回答"我能做哪些、缺哪些"。
// 这比"调用方写死要调哪个工具"更接近真实的多 agent 协作 —— 后者等于
// 把对端的实现细节耦合进了调用方。
export func cap_plan_split(args) {
  let goal = str(get(args, "goal", ""));
  if (len(goal) == 0) { goal = "产出季度经营报告"; }
  // 需求 → 本节点能接的部分。认不出的需求如实标 missing, 不硬凑。
  let needed = split_needs(goal);
  let mine = [];
  let missing = [];
  let i = 0;
  while (i < len(needed)) {
    let need = str(get(needed, i, ""));
    let cap = who_can(need);
    if (str(get(cap, "node", "")) == me_name()) {
      push(mine, { need: need, capability: str(get(cap, "capability", "")) });
    } else if (len(str(get(cap, "capability", ""))) > 0) {
      push(missing, { need: need, capability: str(get(cap, "capability", "")),
                      owner: str(get(cap, "node", "")) });
    } else {
      // 谁都不认领: 明说, 不假装覆盖了
      push(missing, { need: need, capability: "", owner: "",
                      reason: "本节点与已知对端都未声明能处理该需求" });
    }
    i = i + 1;
  }
  let body = {
    node: me_name(),
    goal: goal,
    // 这两个字段是演示的核心输出: 分工结果
    can_handle: mine,
    needs_other: missing,
    verdict: len(missing) == 0 ? "本节点可独立完成" : "需要其它节点协作",
  };
  return { state: "completed", artifacts: [text_artifact(stringify(body))],
           note: "plan split: " + str(len(mine)) + " 项自办 / " + str(len(missing)) + " 项待协作" };
}

// 把目标拆成需求项。演示用固定规则(不接 LLM), 但要能覆盖不同目标 ——
// 否则每种输入都得到同一段输出, 看起来像假的。
func split_needs(goal: string) {
  let out = [];
  let g = lower(goal);
  if (len(str_match("报告|报表|report|汇总", g)) > 0) {
    push(out, "汇总数据");
    push(out, "生成报告正文");
    push(out, "校对口径");
  }
  if (len(str_match("对账|核账|recon", g)) > 0) {
    push(out, "拉取流水");
    push(out, "差异定位");
  }
  if (len(str_match("审计|审|audit", g)) > 0) {
    push(out, "抽样检查");
    push(out, "出具结论");
  }
  if (len(str_match("部署|发布|deploy", g)) > 0) {
    push(out, "构建产物");
    push(out, "灰度验证");
  }
  // 一条都匹配不上: 至少给一个通用需求, 并在结果里如实说明不是精确分解
  if (len(out) == 0) { push(out, "澄清目标"); }
  return out;
}

// 需求 → 谁能处理。演示里按节点名硬编了一部分, 其余按本节点能力判定。
func who_can(need: string) {
  let me = me_name();
  if (need == "汇总数据" or need == "拉取流水") {
    // 数据类需求归 node-a 侧(演示里把它当"数据节点")
    return { node: "node-a", capability: "facts.aggregate" };
  }
  if (need == "生成报告正文" or need == "出具结论") {
    return { node: "node-b", capability: "report.compose" };
  }
  if (need == "校对口径" or need == "抽样检查" or need == "差异定位") {
    return { node: "node-b", capability: "report.review" };
  }
  // 兜底: 本节点认领"澄清目标"
  if (need == "澄清目标") {
    return { node: me, capability: "echo.roundtrip" };
  }
  return { node: "", capability: "" };
}

// ── 2) 多轮补全: 缺参数就反问, 补充后同一 taskId 继续 ────────────────
//
// 这是 A2A 规范里 input-required 的正确用法, 也是**最容易做错**的地方:
// 很多实现遇到缺参数直接失败, 或者自己猜一个默认值接着跑。前者把
// "可以问一下"变成了"报错", 后者更糟 —— 用猜测的默认值产出了看似
// 成功的结果, 而调用方完全不知道数据是编的。
export func cap_report_compose(args) {
  let subject = str(get(args, "subject", ""));
  let period = str(get(args, "period", ""));
  let audience = str(get(args, "audience", ""));
  let missing = [];
  if (len(subject) == 0) { push(missing, "subject(报告主题)"); }
  if (len(period) == 0) { push(missing, "period(统计周期)"); }
  if (len(audience) == 0) { push(missing, "audience(读者是谁)"); }
  if (len(missing) > 0) {
    // input-required: 明确指出缺什么, 让调用方(或人)补齐
    return { state: "input-required", artifacts: [],
             note: "缺少参数: " + join(missing, ", ") +
                   "。请在同一 taskId 上补充后重发。" };
  }
  let body = {
    node: me_name(),
    subject: subject,
    period: period,
    audience: audience,
    title: subject + " · " + period + " 报告",
    sections: section_plan(subject, audience),
    note: "由 " + me_name() + " 组装; 数据由调用方提供",
  };
  return { state: "completed", artifacts: [text_artifact(stringify(body))],
           note: "report composed: " + str(len(section_plan(subject, audience))) + " 节" };
}

func section_plan(subject: string, audience: string) {
  let out = ["背景与口径", "关键指标(" + subject + ")", "异常与归因"];
  if (len(str_match("管理层|高管|老板|exec", lower(audience))) > 0) {
    push(out, "结论与建议(管理层摘要)");
  } else {
    push(out, "明细附录");
  }
  return out;
}

// ── 3) 长任务: 由宿主 worker 推进 submitted → working → completed ─────
//
// 为什么必须落盘并交给外部推进: lume 没有 spawn/exec, http_* 也是同步阻塞。
// "立刻返回任务号、后台慢慢跑" 在纯 lume 里做不到 —— 这不是偷懒, 是语言边界。
// 所以这里只负责**登记**, 推进由 scripts/a2a_worker.py 完成。
export func cap_batch_process(args) {
  // items 可能是数组, 也可能是前端传来的 "a,b,c" 字符串 —— 两种都接受,
  // 否则前端一填逗号分隔就看到一个叫 "a,b,c" 的条目, 数量对不上。
  let raw = get(args, "items", []);
  let items = [];
  if (raw == null) { raw = []; }
  let probe = str_match("^\\[", stringify(raw));
  if (probe != null and len(probe) > 0) {
    let i = 0;
    while (i < len(raw)) { push(items, str(get(raw, i, ""))); i = i + 1; }
  } else {
    let s = str(raw);
    if (len(s) > 0) {
      let parts = split(s, ",");
      let j = 0;
      while (j < len(parts)) {
        let p = trim(str(get(parts, j, "")));
        if (len(p) > 0) { push(items, p); }
        j = j + 1;
      }
    }
  }
  if (len(items) == 0) { items = ["item-1", "item-2", "item-3"]; }
  let secs = int(get(args, "secs", 0));
  return { state: "submitted", artifacts: [],
           note: "batch of " + str(len(items)) + " items",
           // 交给 worker 的派活信息
           job: { kind: "batch", items: items, secs: secs } };
}

// 本节点名。由 lib/peer.lume 读取 PEER_NAME —— 不依赖 a2a.lume 的 node_name(),
// 否则两个模块互相 import 会形成环。
func me_name(): string {
  return str(core_peer.node_info()["name"]);
}

// 构造一个 text artifact。不要从 a2a.lume import 它的 artifact():
// 两个模块互相 import 会成环(--check 报 undefined variable), 干脆各建各的 ——
// 这个结构就是 A2A 规范的固定形状, 不是需要共享的逻辑。
func text_artifact(text: string) {
  return { artifactId: str(core_peer.new_message_id()),
           parts: [{ kind: "text", text: text }] };
}
