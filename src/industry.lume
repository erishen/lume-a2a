// ── 客户公司 → 行业 ─────────────────────────────────────────────────
// 用**关键词**而不是精确匹配: 客户名是用户自己录的, 不可能穷举。
// 顺序有意义 —— 先匹配的更具体(例如"资本/投资"要先于通用的"科技")。
let COMPANY_RULES = [
  { "kw": "资本", "industry": "金融" },
  { "kw": "投资", "industry": "金融" },
  { "kw": "证券", "industry": "金融" },
  { "kw": "基金", "industry": "金融" },
  { "kw": "银行", "industry": "金融" },
  { "kw": "能源", "industry": "电力设备" },
  { "kw": "科技", "industry": "信息技术" },
  { "kw": "软件", "industry": "信息技术" },
  { "kw": "网络", "industry": "信息技术" },
  { "kw": "数据", "industry": "信息技术" },
  { "kw": "汽车", "industry": "汽车" },
  { "kw": "物流", "industry": "交通运输" },
  { "kw": "航运", "industry": "交通运输" },
  { "kw": "置业", "industry": "房地产" },
  { "kw": "地产", "industry": "房地产" },
  { "kw": "食品", "industry": "食品饮料" },
  { "kw": "酒业", "industry": "食品饮料" },
  { "kw": "钢", "industry": "钢铁" },
];

// 去掉空格: scanner 返回 "五 粮 液"(语料里就是分字), 我们表里写 "五粮液"。
// 不归一化的话, 按名字查永远查不到 —— 而我们不会立刻发现, 因为
// 查不到只是"未归类", 页面看起来依然正常。
export func normalize(s: string): string {
  return replace(str(s), " ", "");
}

// 客户公司 → 行业; 认不出返回 ""
export func industry_of_company(company: string): string {
  let c = str(company);
  let i = 0;
  while (i < len(COMPANY_RULES)) {
    let r = get(COMPANY_RULES, i, {});
    if (len(str_match("^.*" + str(get(r, "kw", "")) + ".*$", c)) > 0) {
      return str(get(r, "industry", ""));
    }
    i = i + 1;
  }
  return "";
}

// 该行业下有哪些标的(按 code 查表)。返回 [{code, name, industry}]
export func stocks_in(industry: string): list {
  let out = [];
  let i = 0;
  while (i < len(STOCK_INDUSTRY)) {
    let s = get(STOCK_INDUSTRY, i, {});
    if (str(get(s, "industry", "")) == industry) {
      push(out, { code: str(get(s, "code", "")),
                  name: str(get(s, "name", "")),
                  industry: industry });
    }
    i = i + 1;
  }
  return out;
}

// 按股票名/代码查行业; 查不到 ""
export func industry_of_stock(code: string, name: string): string {
  let c = str(code);
  let n = normalize(name);
  let i = 0;
  while (i < len(STOCK_INDUSTRY)) {
    let s = get(STOCK_INDUSTRY, i, {});
    if (str(get(s, "code", "")) == c or normalize(str(get(s, "name", ""))) == n) {
      return str(get(s, "industry", ""));
    }
    i = i + 1;
  }
  return "";
}

// 本表覆盖的行业(供页面提示"我们认识哪些行业")
export func industries() {
  let seen = {};
  let out = [];
  let i = 0;
  while (i < len(STOCK_INDUSTRY)) {
    let ind = str(get(get(STOCK_INDUSTRY, i, {}), "industry", ""));
    if (get(seen, ind, "") == "") {
      seen = put(seen, ind, "1");
      push(out, ind);
    }
    i = i + 1;
  }
  return out;
}
