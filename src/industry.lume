  { "code": "sh601328", "name": "交通银行", "industry": "金融" },
  { "code": "sh601658", "name": "邮储银行", "industry": "金融" },
  { "code": "sh600036", "name": "招商银行", "industry": "金融" },
  { "code": "sh601318", "name": "中国平安", "industry": "金融" },
