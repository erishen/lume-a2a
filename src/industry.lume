// src/industry.lume — 行业映射表(客户公司 ↔ A 股标的)
//
// ⚠️ 这张表是**人工维护的映射**, 不是 crm / scanner 的真实数据。
//
// 为什么必须单独成表并写清来源:
//   scanner 的 picks 只给 code / name / close / signals / score, **没有行业字段**;
//   crm 的客户只有 name / company / pipeline, 也没有行业。
//   两边都没有"行业", 所以"按行业关联"这件事本身需要一张映射表来支撑。
//   把它藏进业务代码里, 读的人会以为行业是上游给的 —— 那是错的, 而且
//   一旦某只股票改行/被并购, 没人知道该改哪里。
//
// 维护方式: 改下面两张表即可, 不需要动业务逻辑。
//   1) STOCK_INDUSTRY: 股票名 → 行业(键用去掉空格的名字, scanner 返回的
//      "五 粮 液" 与 "五粮液" 要能对上, 见 normalize())
//   2) COMPANY_INDUSTRY: 客户公司 → 行业(按公司名关键词归类, 认不出就返回 "")
//
// 认不出行业时**返回空串**, 由调用方标为"未归类"。不猜 —— 猜错会把
// 制造类客户推进白酒股, 而这种错误在推荐场景里是灾难性的。

// ── 股票 → 行业 ─────────────────────────────────────────────────────
// 覆盖 scanner 标的池中与客户行业相关的部分(金融/信息技术/食品饮料/电力设备/
// 汽车/钢铁/交通运输/房地产)。池子外的标的归为未归类 —— 不猜行业。
let STOCK_INDUSTRY = [
  { "code": "sh601398", "name": "工商银行", "industry": "金融" },
  { "code": "sh601939", "name": "建设银行", "industry": "金融" },
  { "code": "sh601288", "name": "农业银行", "industry": "金融" },
