// check_public.lume — 开原前的闸门: 仓库里不得出现真实凭据
//
// ══ 为什么需要它 ═══════════════════════════════════════════════════════
// 这个仓库要 public, 而它接入的是**本机真实运行的** crm / scanner。
// 开发过程中 .env 里有真实 PEER_ROOT, 一旦哪次不小心 `cp .env .env.bak`
// 或把值写进文档, 泄漏就是不可逆的 —— 派生密钥一旦公开, 任何人都能
// 冒充任何节点签名。
//
// ══ 检查三类 ═══════════════════════════════════════════════════════════
//   1) 文件里出现 .env 中**凭据类**字段的真实值
//   2) 像密钥的长十六进制串(sha 校验上下文除外)
//   3) .gitignore 是否忽略了 .env 与 data/
//
// 只查凭据字段(ROOT/SHARED/SECRET/TOKEN/PASSWORD/API_KEY)。
// 节点名、端口这类值本来就该出现在代码和文档里, 把它们当凭据查会制造大量
// 误报 —— 误报到一定程度, 这条闸门就会被跳过, 等于没有。
//
// ══ 迁移说明 ═══════════════════════════════════════════════════════════
// 原 check_public.py 用 os.walk 递归。lume 的 files(dir) 只列单层,
// 所以这里用显式栈做深度优先遍历 —— 逻辑一样, 少一个 Python 进程。
//
// 用法: lume scripts/check_public.lume
// 退出码: 0 通过; 1 有问题

// 与 check_public.py 保持一致: 这些目录不扫。
// 都不扫的理由不同: .git 是元数据; node_modules/.runtime 是第三方与临时;
// data 是运行产物(可能含真实客户数据); vendor 是预编译二进制;
// www 是构建产物(里面是压缩过的 JS, 长 hex 是常态)。
let skip_dirs = [".git", "node_modules", ".runtime", "data", "vendor", "www"];
let skip_files = ["check_public.py", "check_public.lume"];

// 哪些字段算凭据。用 POSIX ERE 大小写不敏感?
// lume 的 str_match 是 POSIX ERE, 没有内联 (?i) —— 所以两种写法都匹配。
let secret_key_pat = "(ROOT|root|SHARED|shared|SHARED|PRIVKEY|privkey|SECRET|secret|PASSWORD|password|TOKEN|token|API_KEY|api_key)";
// 看起来像密钥的长串(32 位以上十六进制)
let suspect_pat = "[0-9a-fA-F]{32,}";
// 这些上下文里出现长 hex 是正常的(校验和)
let allow_ctx = ["sha", "integrity", "checksum", "hash", "digest"];

let problems = [];

func note(msg: string) {
  push(problems, msg);
}

// 把目录条目分成 子目录 / 文件。files() 的目录带尾部 "/"。
func split_entries(dir: string) {
  // push(x, v) 的第一个参数必须是**变量本身**, 不能写 out.dirs ——
  // 那是"字段表达式", 语法上不当作可修改的左值。所以这里用两份局部
  // list, 最后再装进 map 返回。
  let ds = [];
  let fs = [];
  let ents = files(dir);
  let i = 0;
  while (i < len(ents)) {
    let e = str(get(ents, i, ""));
    if (len(e) > 0) {
      if (substr(e, len(e) - 1, 1) == "/") {
        push(ds, substr(e, 0, len(e) - 1));
      } else {
        push(fs, e);
      }
    }
    i = i + 1;
  }
  return { dirs: ds, files: fs };
}

func is_skipped(dirname: string): bool {
  let i = 0;
  while (i < len(skip_dirs)) {
    if (str(get(skip_dirs, i, "")) == dirname) { return true; }
    i = i + 1;
  }
  return false;
}

// 参数名不能叫 fn: `fn` 是 lambda 关键字(lexer.c:133 TOK_KW_FN)。
func is_skipped_file(name0: string): bool {
  let i = 0;
  while (i < len(skip_files)) {
    if (str(get(skip_files, i, "")) == name0) { return true; }
    i = i + 1;
  }
  // .sha 文件放的是校验和, 天然含长 hex
  if (len(name0) > 4 and substr(name0, len(name0) - 4, 4) == ".sha") { return true; }
  if (name0 == ".env") { return true; }  // 凭据本尊
  return false;
}

// 从 .env 取凭据类字段的真实值(长度 >= 8)。
// 注意: 不打印这些值, 只用来比对是否出现在别的文件里。
func real_secrets() {
  let out = [];
  let txt = read_file(".env");
  if (txt == null) { return out; }
  let lines = split(str(txt), "\n");
  let i = 0;
  while (i < len(lines)) {
    let ln = trim(str(get(lines, i, "")));
    if (len(ln) > 0 and substr(ln, 0, 1) != "#") {
      let eq = 0;
      let found = -1;
      while (eq < len(ln)) {
        if (substr(ln, eq, 1) == "=") { found = eq; eq = len(ln); }
        eq = eq + 1;
      }
      if (found > 0) {
        let k = substr(ln, 0, found);
        let v = trim(substr(ln, found + 1, len(ln) - found - 1));
        // 去引号
        if (len(v) >= 2) {
          let q = substr(v, 0, 1);
          if ((q == "\"" or q == "'") and substr(v, len(v) - 1, 1) == q) {
            v = substr(v, 1, len(v) - 2);
          }
        }
        if (len(v) >= 8 and len(str_match(secret_key_pat, k)) > 0) {
          push(out, v);
        }
      }
    }
    i = i + 1;
  }
  return out;
}

// 遍历: 显式栈做 DFS。不用递归是因为路径可能很深, 而 lume 的栈深度
// 不必为"目录层级"去冒险。
let root = ".";
let stack = ["."];
let scanned = 0;
let secrets = real_secrets();

while (len(stack) > 0) {
  let d = str(get(stack, len(stack) - 1, ""));
  // pop
  let ns = [];
  let si = 0;
  while (si < len(stack) - 1) { push(ns, str(get(stack, si, ""))); si = si + 1; }
  stack = ns;

  let ent = split_entries(d);
  let di = 0;
  while (di < len(ent.dirs)) {
    let sub = str(get(ent.dirs, di, ""));
    if (!is_skipped(sub)) {
      push(stack, d + "/" + sub);
    }
    di = di + 1;
  }

  let fi = 0;
  while (fi < len(ent.files)) {
    let fname = str(get(ent.files, fi, ""));
    fi = fi + 1;
    if (is_skipped_file(fname)) { continue; }
    let path = d + "/" + fname;
    let txt = read_file(path);
    if (txt == null) { continue; }
    let body = str(txt);
    scanned = scanned + 1;

    // 1) 真实凭据值
    let sj = 0;
    while (sj < len(secrets)) {
      if (contains(body, str(get(secrets, sj, "")))) {
        note(path + ": 含有 .env 里的真实凭据");
      }
      sj = sj + 1;
    }

    // 2) 疑似密钥长串
    let hits = str_match(suspect_pat, body);
    let hi = 0;
    while (hi < len(hits)) {
      let h = get(hits, hi, {});
      let idx = int(get(h, "index", 0));
      let from = idx - 40;
      if (from < 0) { from = 0; }
      let ctx = lower(substr(body, from, idx - from));
      let allowed = false;
      let ai = 0;
      while (ai < len(allow_ctx)) {
        if (contains(ctx, str(get(allow_ctx, ai, "")))) { allowed = true; }
        ai = ai + 1;
      }
      if (!allowed) {
        let sample = substr(str(get(h, "text", "")), 0, 8);
        note(path + ": 疑似密钥长串 " + sample + "… (长度 " + str(len(str(get(h, "text", "")))) + ")");
      }
      hi = hi + 1;
    }
  }
}

// 3) .gitignore
let gi = read_file(".gitignore");
if (gi == null) {
  note("缺少 .gitignore");
} else {
  let g = str(gi);
  if (!contains(g, ".env")) { note(".gitignore: 缺少 '.env' 规则"); }
  if (!contains(g, "data/")) { note(".gitignore: 缺少 'data/' 规则"); }
}

// 去重(同一个文件可能被多条规则命中, 报一次就够)
let uniq = [];
let ui = 0;
while (ui < len(problems)) {
  let p = str(get(problems, ui, ""));
  let dup = false;
  let uj = 0;
  while (uj < len(uniq)) {
    if (str(get(uniq, uj, "")) == p) { dup = true; }
    uj = uj + 1;
  }
  if (!dup) { push(uniq, p); }
  ui = ui + 1;
}

if (len(uniq) > 0) {
  print("✗ 开原前检查未通过:");
  let pi = 0;
  while (pi < len(uniq)) {
    print("   - " + str(get(uniq, pi, "")));
    pi = pi + 1;
  }
} else {
  print("✓ 开原前检查通过(.env 中的凭据未出现在任何文件里; 扫描 " + str(scanned) + " 个文件)");
}
