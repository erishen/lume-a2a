// node.lume — 一个 lume A2A 演示节点(服务端)
//
// 起法:
//   PEER_SHARED=<共享密钥> PEER_NAME=node-a PEER_PORT=18190 \
//     ../lume/bin/lume node.lume
//
// 端点:
//   GET  /                         React 控制台(www/)
//   GET  /api/state                本节点状态 + 最近任务
//   GET  /api/capabilities         能力目录(前端面板 + Agent Card 同一来源)
//   GET  /.well-known/agent-card.json   A2A 发现(公开, 未认证, 按规范)
//   POST /a2a                      A2A JSON-RPC(message/send / tasks/get / tasks/cancel)
//   GET  /peer/health              签名: 身份与健康
//   POST /peer/invoke              签名: 按 name 执行一个能力
//   POST /peer/relay               签名: 多跳转发入口
//
// 两套接口并存的原因见 README「双协议」: peer 这套是签名直连(局域网、
// 低延迟、无 JSON-RPC 壳), A2A 那套是标准发现/调用(任何客户端可用)。
// 它们共用同一个 dispatch(), 所以行为不会出现两套口径。
import "../lume-core/lib/peer.lume" as peer;
import "src/a2a.lume" as a2a;
import "src/agent.lume" as agent;
import "src/catalog.lume" as catalog;
import "src/fleet.lume" as fleet;
import "src/graph.lume" as graph;
import "src/negotiate.lume" as negotiate;
import "src/outreach.lume" as outreach;
import "src/trace.lume" as trace;
import "src/entity.lume" as ent;

let bind_addr = env("PEER_BIND");
if (bind_addr == null) { bind_addr = "127.0.0.1"; }
let port_s = env("PEER_PORT");
if (port_s == null) { port_s = "18190"; }

server {
  port = int(port_s);
  workers = 2;
  bind = bind_addr;
  docroot = "./www";
};

// 启动自检: 配了多套凭据时, 实际生效的只有一套。不主动打出来, 排障时
// 会拿错算法去签名, 表现是"全部 401", 很像密钥配错(lib/peer.lume 文件头)。
print("[node] " + a2a.node_name() + " mode=" + peer.key_mode() +
      " port=" + str(port_s) + " caps=" + str(catalog.count()));
let wi = 0;
let warns = peer.config_warnings();
while (wi < len(warns)) {
  print("[node] WARN " + str(get(warns, wi, "")));
  wi = wi + 1;
}

// ── 控制台 API(本机浏览器用, 不需签名: 只读 + 不含凭据) ────────────
get "/api/state", (req) => {
  return {
    ok: true,
    node: a2a.node_name(),
    mode: peer.key_mode(),
    warnings: peer.config_warnings(),
    base_url: a2a.base_url(),
    ts: int(now()),
    tasks: a2a.recent(20),
  };
};

get "/api/capabilities", (req) => {
  return { ok: true, node: a2a.node_name(), capabilities: catalog.all() };
};

// 真实的 peer 节点(crm / scanner): 在线状态 + 它们自己声明的能力。
//
// 故意做成"实时探测"而不是缓存: 演示的重点就是"现在这一刻对端是什么状态"。
// 每次刷新都重新问一遍 /peer/health 与 /peer/tools, 失败就如实显示原因
// (认证被拒 vs 连不上 —— 这两种故障的修法完全不同, 不能都显示"离线")。
// 现场对比: 对同一个真实节点, 分别用「普通 HTTP」和「peer 签名」各请求一次。
//
// 为什么放在服务端而不是浏览器: 浏览器直连对端会撞 CORS, 而且前端也不该
// 持有 PEER_ROOT。服务端代发两个请求, 结果原样返回。
//
// 这里**不伪造结果**: 两个请求都真的发出去, 状态码与响应体取自真实返回。
// 演示里最容易做错的就是"预设结论"—— 那样对端一旦挂了, 页面还是显示漂亮
// 的 404/200 对比, 而这恰恰是必须被看见的异常。

// ══ 实体层接口 ═══════════════════════════════════════════════════════
// 这一层替换掉「按公司名关键词猜行业」的做法。价值不在多一个接口,
// 而在: 同一家公司在任何地方都被认成同一个实体, 且**认不出时会明说**。

// 索引状态: 收录了多少实体、多少带 USCC、多少别名
get "/api/entity/stats", (req) => {
  return { ok: true, stats: graph.stats(), entities: graph.all_entities() };
};

// 解析一个实体。参数三选一即可: uscc / code / name(需已登记别名)。
//   /api/entity/resolve?uscc=91511500MA62A0WM8P
//   /api/entity/resolve?code=600519
//   /api/entity/resolve?name=宁德时代新能源科技股份有限公司
get "/api/entity/resolve", (req) => {
  let q = get(req, "query_params", {});
  let r = graph.resolve(
    str(get(q, "name", "")),
    str(get(q, "uscc", "")),
    str(get(q, "code", "")));
  return { ok: true, result: r };
};


// 对齐度报告: 把实体索引与两个真实来源对照一遍。
//
// 回答一个很实际的问题: "这套实体层现在有多可信?"
//   indexed        索引里有多少实体
//   verified_uscc  其中 USCC 通过校验位的比例(算法保证, 不是人工拍的最好凭据)
//   matched_in_scan 能在 scanner 标的池里找到的(说明代码前缀规范没写错)
//   missing        索引没覆盖、但当日有信号的标的(缺口在哪)
get "/api/entity/coverage", (req) => {
  let ents = graph.all_entities();
  let scanned = fleet.invoke("scanner", "scanner.picks", 25);
  let picks = get(get(scanned, "result", {}), "picks", []);

  let in_scan = 0;
  let missing = [];
  let i = 0;
  while (i < len(picks)) {
    let p = get(picks, i, {});
    let code = ent.norm_code(str(get(p, "code", "")));
    let r = graph.resolve("", "", code);
    if (str(get(r, "status", "")) == "matched") {
      in_scan = in_scan + 1;
    } else {
      push(missing, { code: code, name: str(get(p, "name", "")),
                      reason: "实体索引未收录" });
    }
    i = i + 1;
  }

  let verified = 0;
  let j = 0;
  while (j < len(ents)) {
    let u = str(get(get(ents, j, {}), "uscc", ""));
    if (ent.uscc_valid(u)) { verified = verified + 1; }
    j = j + 1;
  }

  return {
    ok: true,
    indexed: len(ents),
    verified_uscc: verified,
    // 当日有信号且在索引内的 / 当日有信号总数
    matched_in_scan: in_scan,
    scanned_total: len(picks),
    missing_in_scan: missing,
  };
};

// 批量对齐: 把一批「公司名 + 可选 USCC/代码」的输入分类成
// matched / unresolved / invalid。
//
// 三个桶必须分开返回: invalid 是"数据填错了要去修", unresolved 是
// "没收录要去补", 两者的处理人可能都不是同一个。合成一个"未匹配"
// 会让人以为只是没找到, 于是永远没人去修那条脏数据。
post "/api/entity/align", (req) => {
  let parsed = try(() => json(str(get(req, "body", ""))));
  if (parsed.err != null) { return { ok: false, error: "body 不是合法 JSON" }; }
  let b = parsed.ok;
  let rows = get(b, "rows", null);
  if (rows == null or len(rows) == 0) {
    return { ok: false, error: "需要 rows: [{name, uscc?, code?}]" };
  }
  return { ok: true, result: graph.resolve_many(rows) };
};

// 登记/更新一个实体。USCC 校验不过直接拒 —— 不让脏数据进索引。
post "/api/entity/upsert", (req) => {
  let parsed = try(() => json(str(get(req, "body", ""))));
  if (parsed.err != null) { return { ok: false, error: "body 不是合法 JSON" }; }
  let b = parsed.ok;
  let r = graph.upsert(
    str(get(b, "code", "")),
    str(get(b, "name", "")),
    str(get(b, "uscc", "")),
    str(get(b, "industry", "")),
    get(b, "aliases", []));
  return r;
};





// ══ 可实际使用的 Agent: 问一句, 它自己决定查什么 ═════════════════════
//
// 与前面几页的根本区别: 那几页的流程是**写死的**(固定调哪几个接口)。
// 这一页把"该查什么"交给模型判断 —— 用户问"哪些行业值得跟进",
// 它会自己决定去查 scanner.picks + crm.stages, 而不是我事先排好顺序。
//
// 实现是**纯 lume**: 工具注册在 src/agent.lume, ReAct 多轮循环由框架
// (agent.c) 驱动, 前端调 /react/api/chat 走 SSE。这里不再有 Python 服务,
// 也没有"服务不可达"这种失败方式 —— 它就是本站点自己的一部分。
//
// 为什么模型调用不能让 lume 的 http_post 来发: lume 在 .lume 里没有 llm
// 内建(只有 /react/api/chat 这个 HTTP 端点), 而它的 http_post 是同步阻塞的。
// 框架的做法恰好绕开了这点: 子进程 exec curl, 父进程边读边推 SSE。
//
// 这个 GET 端点只做一件事: 给前端报"Agent 是否可用", 让页面在提问前
// 就能提示配置缺失, 而不是等用户点了才报错。
get "/api/agent/ready", (req) => {
  // 这里**不读** LLM_API_KEY: env() 对敏感变量(名字含 API_KEY/SECRET 等)
  // 一律返回 null, 是框架的安全设计 —— 防止脚本把凭据读出来发走。
  // 靠它判断"配置是否就绪"只会得到恒为 false 的结果, 比不判断更误导。
  // 真要确认, 直接提问一次: 没配密钥时框架走离线演示引擎, 答案里看得出来。
  return {
    ok: true,
    tools: agent.registered(),
    max_rounds: 8,
  };
};

// 最近一次的 Agent 问答(快照), 页面首次打开时直接显示, 不用等。
get "/api/agent/last", (req) => {
  let txt = read_file("/app/.data/agent-answer.json");
  if (txt == null) { return { ok: false, ready: false }; }
  let parsed = try(() => json(txt));
  if (parsed.err != null) { return { ok: false, ready: false }; }
  return { ok: true, ready: true, result: parsed.ok };
};

// ══ Agent 过程: 三个节点之间实际发生了什么 ═══════════════════════════
//
// 这页回答的是一个具体问题: **"这次结论是经过哪几个节点、花多久、
// 有没有重试才拿到的"**。
//
// 数据来自 fleet.invoke 的埋点(所有跨节点调用的唯一入口), 不是现编的。
// 所以它能看到的是**真实发生过的调用**, 包括失败的、超时的。
get "/api/agent/trace", (req) => {
  let q = get(req, "query_params", {});
  let n = int(get(q, "n", "40"));
  if (n <= 0) { n = 40; }
  if (n > 200) { n = 200; }
  return {
    ok: true,
    self: a2a.node_name(),
    // 拓扑: 谁是编排方、谁是被调方。前端据此画关系, 而不是写死三个框。
    nodes: fleet.nodes(),
    stats: trace.stats(n),
    events: trace.recent(n),
  };
};

// ══ 客户经营: 今天该联系哪个行业的客户 ═════════════════════════════
//
// 行业整体动向 × 该行业客户 → 落到"什么时候联系谁"。主体是客户。
//
// 输出**不包含任何个股代码**。这不是措辞上的克制, 是产品定位:
// 与荐股的区别不在说法, 在主体 —— 荐股的主体是证券(需持牌),
// 客户经营的主体是客户。项目收敛时已删掉原来的荐股链路(/api/promote)。
get "/api/outreach", (req) => {
  return outreach.plan();
};

// ══ A2A 协商: 两个 agent 谈出一个方案 ═══════════════════════════════
//
// 两个 agent 各持约束, 多轮提案–否决–让步:
//   选股侧提案, 客户侧带约束审议, 谈不拢各自让步,
//   最后给出**双方都接受**的方案 + 完整对话记录。
//
// 后者才是 A2A 的价值: 单个 agent 只能优化自己的目标, 跨系统的最优解
// 需要双方各自持有约束、互相否决、并且能记录"谁让了什么步"。
get "/api/negotiate", (req) => {
  let q = get(req, "query_params", {});
  let goal = str(get(q, "goal", "为本周有信号的标的选定一个优先跟进对象"));
  let r = negotiate.negotiate(goal);
  return { ok: true, result: r };
};

// ── LLM 协商结果(读快照, 不在这里跑 LLM) ────────────────────────────
//
// 为什么走快照而不是在 HTTP 路由里现场调模型:
//   LLM 协商一轮要 5-20 秒, 三轮 + 可能的核对重试, 实测 ~60 秒。
//   放在路由里会让请求长时间挂起、超时、把 workers 占满 —— 而 lume 的
//   workers 只有 2 个, 一个慢请求就能卡住整个控制台。
//
// 所以职责分开:
//   scripts/llm_negotiate.py  跑协商, 写 .data/llm-negotiation.json
//   这个路由                   读快照, 毫秒级返回
// 快照缺失时如实返回"尚未运行", 而不是回退到规则版冒充 LLM 结果。
get "/api/negotiate/llm", (req) => {
  let txt = read_file("/app/.data/llm-negotiation.json");
  if (txt == null) {
    return { ok: false, ready: false,
             error: "尚未运行 LLM 协商。请在宿主执行: make llm-negotiate" };
  }
  let parsed = try(() => json(txt));
  if (parsed.err != null) {
    return { ok: false, ready: false, error: "快照不是合法 JSON" };
  }
  return { ok: true, ready: true, result: parsed.ok };
};

get "/api/fleet", (req) => {
  return { ok: true, self: a2a.node_name(), mode: peer.key_mode(), nodes: fleet.probe_all() };
};

// 在指定节点上执行它声明的能力。body: {"node":"crm","capability":"crm.stats"}
//
// 白名单是**两层**的: 先确认节点在 PEER_FLEET 里, 再确认该能力确实出现在
// 它自己声明的 tools 清单里。只信"清单里有"而不信"名字看起来像", 否则
// 拼错一个名字就会变成对端的未知工具错误, 排查时要跨两台机器。
post "/api/fleet/invoke", (req) => {
  let parsed = try(() => json(str(get(req, "body", ""))));
  if (parsed.err != null) { return { ok: false, error: "body 不是合法 JSON" }; }
  let b = parsed.ok;
  let nm = str(get(b, "node", ""));
  let cap = str(get(b, "capability", ""));
  if (len(nm) == 0 or len(cap) == 0) {
    return { ok: false, error: "需要 node 与 capability" };
  }
  let p = fleet.probe_named(nm);
  if (!get(p, "online", false)) {
    return { ok: false, node: nm, error: str(get(p, "error", "offline")) };
  }
  let ts = get(p, "tools", []);
  let known = false;
  let i = 0;
  while (i < len(ts)) {
    if (str(get(get(ts, i, {}), "name", "")) == cap) { known = true; }
    i = i + 1;
  }
  if (not known) {
    // 埋点: 被**前置白名单**拦下的调用也要留痕。
    // 否则 Agent 页只看得见"走到底的"调用, 而"根本没发出去的"看不见 ——
    // 后者恰恰是排查"为什么这个能力用不了"的第一现场。
    trace.record(a2a.node_name(), nm, cap, 0, false,
                 "该节点未声明该能力", 0, "blocked-by-whitelist");
    return { ok: false, node: nm, error: "该节点未声明能力 '" + cap + "'" };
  }
  let r = fleet.invoke(nm, cap, 20);
  return {
    ok: get(r, "ok", false),
    node: nm,
    capability: cap,
    result: get(r, "result", null),
    error: str(get(r, "error", "")),
  };
};

// 同源签名调用的代理: 浏览器把 args 交过来, 服务端自己签一次再发给对端。
//
// 为什么不让浏览器签: 签名要用 PEER_SHARED, 放进前端等于把密钥发给每个访问
// 者。同源请求又不受 CORS 限制, 所以「浏览器只发业务参数、服务端代签」是
// 这条链路上唯一不需要暴露密钥的做法。
//
// target 只接受同源(空串或本节点 base_url): 否则这个端点会变成一个开放
// 代理 —— 任何能访问控制台的人都能借它去打整个内网。
post "/api/local-invoke", (req) => {
  let parsed = try(() => json(str(get(req, "body", ""))));
  if (parsed.err != null) { return { ok: false, error: "body 不是合法 JSON" }; }
  let body = parsed.ok;
  let nm = str(get(body, "tool", ""));
  let args = get(body, "arguments", {});
  if (catalog.get_cap(nm) == null) {
    return { ok: false, state: "rejected", result: "", error: "unknown tool '" + nm + "'" };
  }
  let target = str(get(body, "target", ""));
  if (len(target) > 0 and target != a2a.base_url()) {
    // 只允许同源: 否则这个端点会变成一个能打穿内网的开放代理。
    return { ok: false, state: "rejected", result: "",
             error: "本代理只允许同源调用(多跳转发能力已在收敛时移除)" };
  }
  let r = a2a.dispatch(nm, str(get(args, "text", "")), args, int(get(args, "hops", 0)));
  return {
    ok: get(r, "state", "") == "completed",
    node: a2a.node_name(),
    state: get(r, "state", ""),
    result: first_artifact_body(get(r, "artifacts", [])),
    note: get(r, "note", ""),
  };
};

// ── A2A 发现 ────────────────────────────────────────────────────────
// 规范要求 Agent Card 公开未认证: 客户端必须先能发现, 再决定是否认证。
// 所以这里只放能公开的信息(名称/能力/地址), 不放任何凭据。
get "/.well-known/agent-card.json", (req) => {
  return a2a.card();
};

// ── A2A JSON-RPC ────────────────────────────────────────────────────
// SSE 事件流。返回 { sse: [...] } —— bridge_serve.c 逐条发 data: 帧,
// 且**只在客户端 Accept: text/event-stream 时**才走流式, 否则退回普通 JSON。
//
// 事件按 A2A 规范发三类:
//   status-update    状态变化(submitted → working → completed), 带 final 标记
//   artifact-update  产物分块(append=false 表示首块)
// 最后一帧 status-update 的 final=true 表示流结束。
func handle_stream(mid, params) {
  let text = message_text(params);
  let md = get(params, "metadata", {});
  let cap = str(get(md, "capability", ""));
  let args = get(md, "args", {});
  let hops = int(get(md, "hops", 0));
  let ctx = str(get(params, "contextId", ""));
  if (len(cap) == 0) { cap = a2a.guess_cap(text); }
  let events = [];

  if (len(cap) == 0) {
    let t = a2a.new_task(ctx, "unknown", text, hops);
    let tid = str(get(t, "id", ""));
    push(events, sse_frame(mid, tid, ctx, "status-update",
      { state: "input-required", timestamp: str(now()),
        message: { role: "agent", parts: [{ kind: "text",
          text: "请指定 capability: " + join(cap_names(), ", ") }] } }, true, "", null));
  }

  let t = a2a.new_task(ctx, cap, text, hops);
  let tid = str(get(t, "id", ""));
  push(events, sse_frame(mid, tid, ctx, "status-update",
    { state: "submitted", timestamp: str(now()) }, false, "", null));

  a2a.advance(tid, "working", null, "stream dispatch " + cap);
  push(events, sse_frame(mid, tid, ctx, "status-update",
    { state: "working", timestamp: str(now()) }, false, "", null));

  let r = a2a.dispatch(cap, text, args, hops);
  let st = str(get(r, "state", "failed"));
  let arts = get(r, "artifacts", []);
  // submitted 状态的长任务(如 batch.process): 现在就结束流, 让客户端去轮询
  // tasks/get。占着流等一个由外部进程推进的任务, 是最常见的实现错误 ——
  // 客户端会等到超时, 而任务其实还在正常跑。
  if (st == "submitted") {
    let done = a2a.advance(tid, "submitted", [], str(get(r, "note", "")));
    push(events, sse_frame(mid, tid, ctx, "status-update",
      { state: "submitted", timestamp: str(now()) }, true,
      "任务已登记; 用 tasks/get 轮询进度", null));
    return { sse: events };
  }
  if (len(arts) > 0) {
    let art = get(arts, 0, {});
    push(events, sse_frame(mid, tid, ctx, "artifact-update", {},
      false, "", { artifactId: str(get(art, "artifactId", "")),
                   parts: get(art, "parts", []) }));
  }
  let done2 = a2a.advance(tid, st, arts, str(get(r, "note", "")));
  push(events, sse_frame(mid, tid, ctx, "status-update",
    { state: st, timestamp: str(now()) }, true, str(get(r, "note", "")), null));
  return { sse: events };
}

// 拼一帧 A2A 事件(JSON-RPC result 包着事件本体)
func sse_frame(mid, task_id: string, ctx: string, kind: string, status,
               final: bool, note: string, art) {
  let res = { taskId: task_id, contextId: ctx, kind: kind };
  if (len(note) > 0) { res = put(res, "note", note); }
  if (kind == "status-update") {
    res = put(res, "status", status);
    res = put(res, "final", final);
  }
  if (kind == "artifact-update" and art != null) {
    res = put(res, "artifact", art);
    res = put(res, "append", false);
    res = put(res, "lastChunk", true);
  }
  return stringify({ jsonrpc: "2.0", id: mid, result: res });
}

post "/a2a", (req) => {
  let raw = str(get(req, "body", ""));
  let parsed = try(() => json(raw));
  if (parsed.err != null) {
    return rpc_error(null, -32700, "parse error");
  }
  let rpc = parsed.ok;
  let mid = get(rpc, "id", null);
  let method = str(get(rpc, "method", ""));
  let params = get(rpc, "params", {});

  if (method == "message/send" or method == "tasks/send") {
    return handle_send(mid, params);
  }
  // message/stream: 真 SSE 事件流(status-update / artifact-update)。
  //
  // ⚠️ 这是「同步执行 + 事件回放」, 不是边跑边推 —— lume 没有异步原语,
  // 事件在 handler 返回时一次性生成。事件序列符合同一规范, 但没有"边跑边看",
  // 所以前端面板会明确写"回放", 不让看的人误以为看到了实时进度。
  if (method == "message/stream" or method == "message/streaming") {
    return handle_stream(mid, params);
  }
  if (method == "tasks/get" or method == "GetTask") {
    let t = a2a.load(str(get(params, "id", "")));
    if (t == null) { return rpc_error(mid, -32001, "task not found"); }
    return { jsonrpc: "2.0", id: mid, result: t };
  }
  if (method == "tasks/cancel" or method == "CancelTask") {
    let id = str(get(params, "id", ""));
    let t = a2a.load(id);
    if (t == null) { return rpc_error(mid, -32001, "task not found"); }
    let st = str(get(get(t, "status", {}), "state", ""));
    if (a2a.is_terminal(st)) {
      return rpc_error(mid, -32002, "task not cancelable (state=" + st + ")");
    }
    return { jsonrpc: "2.0", id: mid, result: a2a.advance(id, "canceled", null, "canceled by client") };
  }
  return rpc_error(mid, -32601, "method not found: " + method);
};

func rpc_error(mid, code: int, msg: string) {
  return { jsonrpc: "2.0", id: mid, error: { code: code, message: msg } };
}

// 取 A2A 消息里的纯文本(parts 里可能有 text/file/data, 这里只取 text)
func message_text(params) {
  let parts = get(get(params, "message", {}), "parts", []);
  let out = "";
  let i = 0;
  while (i < len(parts)) {
    let p = get(parts, i, {});
    if (str(get(p, "kind", "")) == "text") {
      let t = str(get(p, "text", ""));
      if (len(out) > 0) { out = out + "\n"; }
      out = out + t;
    }
    i = i + 1;
  }
  return out;
}

func handle_send(mid, params) {
  let text = message_text(params);
  let md = get(params, "metadata", {});
  let cap = str(get(md, "capability", ""));
  let args = get(md, "args", {});
  let hops = int(get(md, "hops", 0));
  let ctx = str(get(params, "contextId", ""));
  if (len(cap) == 0) { cap = a2a.guess_cap(text); }

  // ── 多轮续发: 客户端带 taskId 继续一个 input-required 的任务 ──────
  //
  // 这是 A2A 规范里最容易被做错的一块。三个必须守住的点:
  //   1) 已终结的任务**不可重启**(任务不可变性) —— 追问要开新任务, 回 -32004;
  //   2) 用户这一轮补充的参数要合并进原有 args, 而不是整个替换;
  //   3) 补充后状态回到 submitted, 让 worker/本次调用重新拾起。
  let resume = str(get(params, "id", ""));
  if (len(resume) == 0) { resume = str(get(get(params, "message", {}), "taskId", "")); }
  if (len(resume) > 0) {
    return resume_task(mid, resume, text, args);
  }

  // 认不出能力: 回 input-required 让客户端明确指定, 而不是猜一个跑。
  // 猜错的代价是"看起来成功了但答非所问", 比多问一轮糟。
  if (len(cap) == 0) {
    let t = a2a.new_task(ctx, "unknown", text, hops);
    let id = str(get(t, "id", ""));
    let msg = "请指定 capability: " + join(cap_names(), ", ");
    return { jsonrpc: "2.0", id: mid,
             result: a2a.advance_with_message(id, "input-required", msg) };
  }

  let t = a2a.new_task(ctx, cap, text, hops);
  let id = str(get(t, "id", ""));
  // 记住本轮参数: input-required 之后续发时要合并, 不能只看这一轮的 args
  a2a.remember_args(id, args);
  a2a.advance(id, "working", null, "dispatch " + cap);
  let r = a2a.dispatch(cap, text, args, hops);
  let st = str(get(r, "state", "failed"));

  // 长任务: 派活信息塞进 metadata.payload, 由宿主 worker 推进。
  // 这里**不**调 advance 改成 completed —— 那等于假装干完了。
  if (st == "submitted") {
    a2a.store_payload(id, get(r, "job", null));
    let t2 = a2a.advance(id, "submitted", [], str(get(r, "note", "")));
    return { jsonrpc: "2.0", id: mid, result: t2 };
  }
  // input-required 必须带 status.message: 客户端要知道"缺什么"才能补。
  // 只把状态改成 input-required 而不写 message, 客户端拿到的是一个
  // "需要你补充, 但不说什么" 的任务 —— 实测就是这样, 而且从返回值看不出
  // 任何异常(字段都在, 只是 message 为空)。
  if (st == "input-required") {
    return { jsonrpc: "2.0", id: mid,
             result: a2a.advance_with_message(id, st, str(get(r, "note", ""))) };
  }
  let done = a2a.advance(id, st, get(r, "artifacts", []), str(get(r, "note", "")));
  return { jsonrpc: "2.0", id: mid, result: done };
}

// 续发: 合并参数 → 重新派发
func resume_task(mid, task_id: string, text: string, args) {
  let existing = a2a.load(task_id);
  if (existing == null) {
    return rpc_error(mid, -32001, "task not found: " + task_id);
  }
  let state = str(get(get(existing, "status", {}), "state", ""));
  if (a2a.is_terminal(state)) {
    // 规范的任务不可变性: 编码在 -32004, 客户端据此开新任务而不是重试
    return rpc_error(mid, -32004,
      "任务已终结(" + state + "), 不可恢复; 请在同一 contextId 下发起新任务");
  }
  if (state != "input-required") {
    // 还在跑的任务不接受续发 —— 否则会出现两条并行推进, 结果互相覆盖
    return rpc_error(mid, -32005, "任务正在处理中(" + state + "), 无需补充");
  }
  a2a.append_user_message(task_id, text);
  // 合并: 原有 args 作底, 本轮补充覆盖
  let merged = a2a.merged_args(task_id, args);
  // 立即把合并结果写回任务 —— 不写回的话, 下一次续发又是从旧参数开始,
  // 于是用户刚补的字段"消失"了, 表现为"补了还说缺"(实测踩过)。
  a2a.remember_args(task_id, merged);
  let cap = str(get(get(existing, "metadata", {}), "capability", ""));
  a2a.advance(task_id, "working", null, "resumed by client");
  let r = a2a.dispatch(cap, text, merged, int(get(get(existing, "metadata", {}), "hops", 0)));
  let st = str(get(r, "state", "failed"));
  if (st == "submitted") {
    a2a.store_payload(task_id, get(r, "job", null));
    return { jsonrpc: "2.0", id: mid,
             result: a2a.advance(task_id, "submitted", [], str(get(r, "note", ""))) };
  }
  let note = str(get(r, "note", ""));
  if (st == "input-required") {
    // 仍然缺参数: 保持 input-required, 但不覆盖之前的提问语义
    return { jsonrpc: "2.0", id: mid, result: a2a.advance_with_message(task_id, st, note) };
  }
  return { jsonrpc: "2.0", id: mid,
           result: a2a.advance(task_id, st, get(r, "artifacts", []), note) };
}

func cap_names() {
  let cs = catalog.all();
  let out = [];
  let i = 0;
  while (i < len(cs)) { push(out, str(get(get(cs, i, {}), "name", ""))); i = i + 1; }
  return out;
}

// ── peer 面: 签名接口 ───────────────────────────────────────────────
get "/peer/health", (req) => {
  let v = peer.verify_get(req);
  if (!get(v, "ok", false)) {
    return { ok: false, unauthorized: true, error: get(v, "error", "") };
  }
  return {
    ok: true,
    node: a2a.node_name(),
    peer: get(v, "node", ""),
    ts: int(now()),
    mode: peer.key_mode(),
    caps: catalog.count(),
    warnings: peer.config_warnings(),
  };
};

// 执行一个能力。body: {"tool":"<name>","arguments":{...}}
// 白名单: 只认 catalog 里声明过的名字。未知名直接拒, 不做任何兜底转发 ——
// 这条链路是局域网互信域, 兜底转发等于给对端一个任意调用的入口。
post "/peer/invoke", (req) => {
  let body = str(get(req, "body", ""));
  let v = peer.verify_post(req);
  if (!get(v, "ok", false)) {
    return { ok: false, unauthorized: true, error: get(v, "error", "") };
  }
  let parsed = try(() => json(body));
  if (parsed.err != null) { return { ok: false, error: "body 不是合法 JSON" }; }
  let nm = str(get(parsed.ok, "tool", ""));
  if (len(nm) == 0) { return { ok: false, error: "缺少 tool 字段" }; }
  if (catalog.get_cap(nm) == null) {
    return { ok: false, "tool": nm, error: "unknown tool '" + nm + "'" };
  }
  let args = get(parsed.ok, "arguments", {});
  let text = str(get(args, "text", ""));
  let r = a2a.dispatch(nm, text, args, int(get(args, "hops", 0)));
  return {
    ok: get(r, "state", "") == "completed",
    node: a2a.node_name(),
    "tool": nm,
    state: get(r, "state", ""),
    result: first_artifact_body(get(r, "artifacts", [])),
    artifacts: get(r, "artifacts", []),
    note: get(r, "note", ""),
  };
};

// 多跳转发: 已退役。
//
// 原来的实现依赖 echo.roundtrip 与 hops 计数, 两者都是为演示协议造的假能力。
// 收敛时一起移除了。这里保留端点并**明确返回 410**, 而不是删掉路由:
//   删掉的话, 老客户端会收到 404 并以为是"路径写错";
//   返回 410 + 原因, 它才知道是"能力退役了, 该改调用方式"。
post "/peer/relay", (req) => {
  let body = str(get(req, "body", ""));
  let v = peer.verify_post(req);
  if (!get(v, "ok", false)) {
    return { ok: false, unauthorized: true, error: get(v, "error", "") };
  }
  return {
    status: 410,
    ok: false,
    node: a2a.node_name(),
    error: "relay 已退役: 多跳转发能力在项目收敛时移除。",
    hint: "请改用 POST /peer/invoke 直接调用本节点的能力; 能力清单见 /.well-known/agent-card.json",
  };
};

// artifact 里的正文(演示链路都是单 text part)。取不到给空串而不是 null:
// 调用方拿到的永远是字符串, 少一处判空。
func first_artifact_body(arts) {
  if (len(arts) == 0) { return ""; }
  let parts = get(get(arts, 0, {}), "parts", []);
  if (len(parts) == 0) { return ""; }
  return str(get(get(parts, 0, {}), "text", ""));
}

run();

